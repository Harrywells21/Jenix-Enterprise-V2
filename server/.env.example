# JENIX Enterprise — Environment Variables
# Copy this to .env and fill in your values

# Security
SECRET_KEY=change_this_to_a_long_random_string_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Database
DATABASE_URL=sqlite:///./jenix.db

# Default admin account (change on first login)
ADMIN_EMAIL=admin@jenix.io
ADMIN_PASSWORD=admin123

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Slack webhook (optional)
SLACK_WEBHOOK=

# Teams webhook (optional)
TEAMS_WEBHOOK=
