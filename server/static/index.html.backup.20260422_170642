function AddMachineWizard({onClose,token,toast}){
  const [step,setStep]=useState(1);
  const [os,setOs]=useState(null);
  const [checking,setChecking]=useState(false);
  const [verified,setVerified]=useState(false);
  const SERVER='http://192.168.56.102:8000';

  const check=async()=>{
    setChecking(true);
    try{
      const t=token||'';
      const r=await fetch('/api/nodes',{headers:{'Authorization':`Bearer ${t}`}});
      if(r.ok){
        const d=await r.json();
        const ns=Array.isArray(d)?d:(d.nodes||[]);
        const online=ns.filter(n=>n.is_online);
        if(online.length>0){
          setVerified(true);
          toast(`✓ ${online.length} machine(s) connected!`,'tok');
        } else {
          toast('Not detected yet — wait 15 seconds and try again','twarn');
        }
      }
    }catch(e){toast('Check failed','terr');}
    setChecking(false);
  };

  const S={
    overlay:{position:'fixed',top:0,left:0,right:0,bottom:0,background:'rgba(0,0,0,0.85)',zIndex:9999,display:'flex',alignItems:'center',justifyContent:'center',padding:16},
    box:{background:'#0d1d35',border:'1px solid #1e3a5f',borderRadius:20,width:540,maxWidth:'100%',padding:'32px 36px'},
    title:{fontSize:22,fontWeight:800,color:'#fff',marginBottom:4},
    sub:{fontSize:13,color:'#5a8ab0',marginBottom:28},
    osGrid:{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:12,marginBottom:28},
    osBtn:(sel)=>({background:sel?'#1a3a6f':'#091525',border:`2px solid ${sel?'#3a7fff':'#1e3a5f'}`,borderRadius:14,padding:'20px 10px',cursor:'pointer',textAlign:'center',transition:'all .2s'}),
    osIcon:{fontSize:32,marginBottom:8},
    osName:{fontSize:13,fontWeight:700,color:'#fff'},
    codeBox:{background:'#060e1c',border:'1px solid #1a3050',borderRadius:10,padding:'16px 18px',fontFamily:'monospace',fontSize:12,color:'#5af',lineHeight:1.9,marginBottom:16,wordBreak:'break-all'},
    note:{background:'#0a1e35',border:'1px solid #1a3050',borderRadius:8,padding:'10px 14px',fontSize:12,color:'#5a8ab0',marginBottom:20},
    btnRow:{display:'flex',justifyContent:'space-between',alignItems:'center',marginTop:8},
    btnPrimary:{background:'#2060ff',color:'#fff',border:'none',borderRadius:10,padding:'11px 26px',cursor:'pointer',fontSize:14,fontWeight:700},
    btnSecondary:{background:'transparent',color:'#5a8ab0',border:'1px solid #1e3a5f',borderRadius:10,padding:'11px 20px',cursor:'pointer',fontSize:13},
    steps:{display:'flex',alignItems:'center',gap:0,marginBottom:28},
    stepDot:(n)=>({width:32,height:32,borderRadius:'50%',background:step>=n?'#2060ff':'#0d1e35',border:`2px solid ${step>=n?'#2060ff':'#1e3a5f'}`,color:step>=n?'#fff':'#5a8ab0',display:'flex',alignItems:'center',justifyContent:'center',fontSize:13,fontWeight:700,flexShrink:0}),
    stepLine:(n)=>({flex:1,height:2,background:step>n?'#2060ff':'#1e3a5f'}),
    stepLabel:{fontSize:10,color:'#5a8ab0',marginTop:4,textAlign:'center',fontFamily:'monospace'},
    successBox:{background:'#0a2a15',border:'2px solid #1a7a40',borderRadius:12,padding:20,textAlign:'center',marginBottom:20},
  };

  const cmds = {
    Linux: `curl -fsSL ${SERVER}/api/agent/install/linux | bash`,
    macOS: `curl -fsSL ${SERVER}/api/agent/install/macos | bash`,
    Windows: `iwr -useb ${SERVER}/api/agent/install/windows | iex`,
  };

  const stepLabels = ['Choose OS','Install','Verify','Done'];

  return h('div',{style:S.overlay,onClick:e=>{if(e.target===e.currentTarget)onClose()}},
    h('div',{style:S.box},

      // Header
      h('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:6}},
        h('div',null,
          h('div',{style:S.title},'➕ Add a Machine'),
          h('div',{style:S.sub},'Follow the steps — takes less than 2 minutes')
        ),
        h('button',{onClick:onClose,style:{background:'none',border:'none',color:'#5a8ab0',fontSize:22,cursor:'pointer',lineHeight:1}},'×')
      ),

      // Step indicators
      h('div',{style:S.steps},
        ...[1,2,3,4].flatMap((n,i)=>[
          h('div',{key:`s${n}`,style:{display:'flex',flexDirection:'column',alignItems:'center'}},
            h('div',{style:S.stepDot(n)}, step>n ? '✓' : n),
            h('div',{style:S.stepLabel},stepLabels[n-1])
          ),
          i<3&&h('div',{key:`l${n}`,style:S.stepLine(n)})
        ].filter(Boolean))
      ),

      // STEP 1 — Choose OS
      step===1&&h('div',null,
        h('div',{style:{fontSize:15,fontWeight:700,color:'#e0f0ff',marginBottom:6}},'What OS is the machine running?'),
        h('div',{style:{fontSize:12,color:'#5a8ab0',marginBottom:18}},'Tap your operating system to continue.'),
        h('div',{style:S.osGrid},
          [
            {id:'Linux',icon:'🐧',name:'Linux',sub:'Ubuntu, Debian, CentOS…'},
            {id:'macOS',icon:'🍎',name:'macOS',sub:'MacBook, Mac Mini…'},
            {id:'Windows',icon:'🪟',name:'Windows',sub:'Windows 10/11, Server…'},
          ].map(o=>h('div',{key:o.id,style:S.osBtn(os===o.id),onClick:()=>{setOs(o.id);setStep(2);}},
            h('div',{style:S.osIcon},o.icon),
            h('div',{style:S.osName},o.name),
            h('div',{style:{fontSize:10,color:'#5a8ab0',marginTop:3}},o.sub)
          ))
        ),
        h('div',{style:{textAlign:'center',fontSize:12,color:'#3a6090'}},'👆 Tap an option to automatically go to the next step')
      ),

      // STEP 2 — Install
      step===2&&h('div',null,
        h('div',{style:{fontSize:15,fontWeight:700,color:'#e0f0ff',marginBottom:4}},
          os==='Linux'?'🐧 Linux':'macOS'?'🍎 macOS':'🪟 Windows',
          ' — Open a terminal and run:'
        ),
        h('div',{style:{fontSize:12,color:'#5a8ab0',marginBottom:14}},'Copy the command below and paste it in a terminal on the machine you want to add.'),
        h('div',{style:S.codeBox},
          h('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:8}},
            h('span',{style:{fontSize:10,color:'#3a6090',fontFamily:'monospace'}},os==='Windows'?'PowerShell (Admin)':'Terminal'),
            h('button',{
              onClick:()=>{navigator.clipboard?.writeText(cmds[os]);toast('Command copied!','tok');},
              style:{background:'#1a3a6f',border:'none',borderRadius:6,color:'#7ac',padding:'3px 10px',cursor:'pointer',fontSize:11}
            },'📋 Copy')
          ),
          cmds[os]
        ),
        os==='Windows'&&h('div',{style:{...S.note,borderColor:'#2a4a6f'}},
          '💡 Open PowerShell as Administrator: Press ',
          h('kbd',{style:{background:'#1a3050',padding:'1px 6px',borderRadius:4,fontFamily:'monospace'}},'Win+X'),
          ' → "Windows PowerShell (Admin)"'
        ),
        os==='macOS'&&h('div',{style:S.note},
          '💡 Open Terminal: Press ',
          h('kbd',{style:{background:'#1a3050',padding:'1px 6px',borderRadius:4,fontFamily:'monospace'}},'Cmd+Space'),
          ' → type "Terminal" → Enter'
        ),
        os==='Linux'&&h('div',{style:S.note},
          '💡 Open Terminal: Press ',
          h('kbd',{style:{background:'#1a3050',padding:'1px 6px',borderRadius:4,fontFamily:'monospace'}},'Ctrl+Alt+T')
        ),
        h('div',{style:S.btnRow},
          h('button',{style:S.btnSecondary,onClick:()=>setStep(1)},'← Change OS'),
          h('button',{style:S.btnPrimary,onClick:()=>setStep(3)},"I ran it — Check connection →")
        )
      ),

      // STEP 3 — Verify
      step===3&&h('div',null,
        h('div',{style:{fontSize:15,fontWeight:700,color:'#e0f0ff',marginBottom:4}},'🔍 Checking Connection…'),
        h('div',{style:{fontSize:12,color:'#5a8ab0',marginBottom:20}},'The agent needs 10-30 seconds to connect after you run the command. Click the button to check.'),
        !verified&&h('button',{
          style:{...S.btnPrimary,width:'100%',padding:14,fontSize:14,marginBottom:12,opacity:checking?0.7:1},
          onClick:check,
          disabled:checking
        }, checking ? '⏳ Checking…' : '🔍 Check Connection Now'),
        verified&&h('div',{style:S.successBox},
          h('div',{style:{fontSize:36,marginBottom:8}},'✅'),
          h('div',{style:{fontSize:16,fontWeight:800,color:'#4fff90'}}, 'Connected!'),
          h('div',{style:{fontSize:12,color:'#5a8ab0',marginTop:6}},'Your machine is now visible in the dashboard')
        ),
        h('div',{style:{fontSize:11,color:'#3a5070',textAlign:'center',marginBottom:16}},
          'Not connecting? Make sure the command finished without errors and your machine can reach ',
          h('span',{style:{color:'#4a80c0'}},SERVER)
        ),
        h('div',{style:S.btnRow},
          h('button',{style:S.btnSecondary,onClick:()=>setStep(2)},'← Back'),
          h('button',{
            style:{...S.btnPrimary,opacity:verified?1:0.35,cursor:verified?'pointer':'not-allowed'},
            onClick:()=>{if(verified)setStep(4);else toast('Please verify connection first','twarn');}
          },'Finish →')
        )
      ),

      // STEP 4 — Done
      step===4&&h('div',{style:{textAlign:'center',padding:'10px 0'}},
        h('div',{style:{fontSize:56,marginBottom:12}},'🎉'),
        h('div',{style:{fontSize:20,fontWeight:800,color:'#fff',marginBottom:8}},'Machine Added!'),
        h('div',{style:{fontSize:13,color:'#5a8ab0',marginBottom:24}},'It will appear in your Node Fleet and update every 10 seconds.'),
        h('div',{style:{background:'#091525',borderRadius:12,padding:16,marginBottom:24,textAlign:'left'}},
          h('div',{style:{fontSize:12,color:'#4fff90',marginBottom:6}},'✓ Agent installed and running'),
          h('div',{style:{fontSize:12,color:'#4fff90',marginBottom:6}},'✓ Node registered in JENIX'),
          h('div',{style:{fontSize:12,color:'#4fff90'}},'✓ Metrics streaming live')
        ),
        h('div',{style:{display:'flex',gap:12,justifyContent:'center'}},
          h('button',{style:{...S.btnSecondary},onClick:()=>{setStep(1);setOs(null);setVerified(false);}},'+  Add Another'),
          h('button',{style:S.btnPrimary,onClick:onClose},'View Dashboard →')
        )
      )
    )
  );
}

