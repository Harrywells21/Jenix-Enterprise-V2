    {ico:'⬡',label:'Nodes',sub:'Fleet node list',fn:()=>onNav('nodes')},
    {ico:'⚡',label:'Fleet Commands',sub:'Send commands to all nodes',fn:()=>onNav('fleet')},
    {ico:'◉',label:'Alerts',sub:'Active incidents',fn:()=>onNav('alerts')},
