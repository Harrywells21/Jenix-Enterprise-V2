      h('div',{className:'pal-search'},h('span',{style:{color:'var(--text3)',fontSize:16}},'⌕'),h('input',{ref,className:'pal-input',placeholder:'Search nodes, pages, commands…',value:q,onChange:e=>setQ(e.target.value),onKeyDown:e=>e.key==='Escape'&&onClose()})),
