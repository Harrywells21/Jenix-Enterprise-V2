/* ═══ APP ═══ */
function App(){
  const[authed,setAuthed]=useState(false);
  const[username,setUsername]=useState('admin');
  const[page,setPage]=useState('overview');
  const[selNode,setSelNode]=useState(null);
  const[nodes,setNodes]=useState([]);
  const[alerts,setAlerts]=useState(MOCK_ALERTS);
  const[palette,setPalette]=useState(false);
  const[expanded,setExpanded]=useState(true);
  const{ts,toast}=useToast();
  const[time,setTime]=useState(new Date().toLocaleTimeString());
  const token=useRef('');

  useEffect(()=>{
    if(!authed)return;
    // Fetch real nodes from API
    const loadNodes=async()=>{
      try{
        const r=await fetch('/api/nodes',{headers:{'Authorization':`Bearer ${token.current}`}});
        if(r.ok){const d=await r.json();setNodes(Array.isArray(d)?d:(d.nodes||[]));}
      }catch(e){}
    };
    loadNodes();
    const t=setInterval(()=>{
      loadNodes();
      setTime(new Date().toLocaleTimeString());
    },10000);
    return()=>clearInterval(t);
  },[authed]);

  useEffect(()=>{
    const h=e=>{if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();setPalette(p=>!p);}if(e.key==='Escape')setPalette(false);};
    window.addEventListener('keydown',h);return()=>window.removeEventListener('keydown',h);
  },[]);

  function login(tok,uname){token.current=tok;setUsername(uname);setAuthed(true);}
  function nav(p){setPage(p);if(p!=='node-detail')setSelNode(null);}
  function selectNode(n){setSelNode(n);setPage('node-detail');}

  if(!authed)return h(LoginScreen,{onLogin:login});

  const online=nodes.filter(n=>n.is_online).length;
  const alertCount=alerts.filter(a=>!a.resolved).length;

  const NAV=[
    {id:'overview',ico:'◈',label:'Overview'},
    {id:'nodes',ico:'⬡',label:'Nodes',badge:nodes.filter(n=>!n.is_online).length||null},
    {id:'fleet',ico:'⚡',label:'Fleet Commands'},
    {id:'alerts',ico:'◉',label:'Alerts',badge:alertCount||null},
    {id:'compliance',ico:'🛡',label:'Compliance'},
    {id:'settings',ico:'⚙',label:'Settings'},
  ];
  const activePage=page==='node-detail'?'nodes':page;

  return h('div',{className:`shell ${expanded?'wide':''}`},
    /* Ambient */
    h('div',{className:'ambient'},h('div',{className:'amb1 ambient-orb'}),h('div',{className:'amb2 ambient-orb'}),h('div',{className:'amb3 ambient-orb'})),
    h('div',{className:'grid-bg'}),

    /* Sidebar */
    h('div',{className:'sidebar'},
      h('div',{className:'sb-logo',onClick:()=>setExpanded(e=>!e)},
        h('div',{className:'logo-hex'},'J'),
        expanded&&h('div',null,h('div',{className:'logo-wordmark'},'JENIX'),h('div',{className:'logo-sub'},'Enterprise v3.0'))
      ),
      h('div',{className:'sb-nav'},
        expanded&&h('div',{className:'nav-section-label'},'Navigation'),
        NAV.map(item=>h('div',{key:item.id,className:`nav-item ${activePage===item.id?'active':''}`,onClick:()=>nav(item.id),title:!expanded?item.label:''},
          h('span',{className:'nav-icon'},item.ico),
          expanded&&h('span',{className:'nav-label'},item.label),
          expanded&&item.badge&&h('span',{className:`nav-badge ${item.badge===0?'zero':''}`},item.badge)
        )),
        expanded&&h('div',{className:'nav-section-label',style:{marginTop:12}},'Quick Access'),
        expanded&&nodes.filter(n=>n.is_online).slice(0,4).map(n=>h('div',{key:n.id,className:'nav-item',onClick:()=>selectNode(n),style:{padding:'7px 10px'}},
          h('span',{className:'nav-icon',style:{fontSize:14}},OS_ICO[n.os_type]),
          h('span',{className:'nav-label',style:{fontSize:11}},n.name),
          h('div',{style:{width:6,height:6,borderRadius:'50%',background:'var(--emerald)',flexShrink:0,boxShadow:'0 0 6px var(--emerald)'}})
        ))
      ),
      h('div',{className:'sb-user'},
        h('div',{className:'user-avatar'},username[0]?.toUpperCase()),
        expanded&&h('div',{className:'user-info'},h('div',{className:'user-name'},username),h('div',{className:'user-role'},'Admin')),
        expanded&&h('span',{className:'user-logout',onClick:()=>setAuthed(false),title:'Logout'},'↩')
      )
    ),

    /* Main */
    h('div',{className:'main'},
      /* Topbar */
      h('div',{className:'topbar'},
        h('div',{className:'search-trigger',onClick:()=>setPalette(true)},
          h('span',{className:'search-icon'},'⌕'),
          h('span',{className:'search-ph'},'Search nodes, pages, commands…'),
          h('span',{className:'search-kbd'},'⌘K')
        ),
        h('div',{className:'tb-right'},
          h('div',{className:'tb-stat'},h('div',{className:'tb-val'},[online,'/',nodes.length]),h('div',{className:'tb-lbl'},'Online')),
          h('div',{className:`tb-pill ${alertCount>0?'tb-warn':'tb-ok'}`},h('div',{className:'live-dot'}),alertCount>0?`${alertCount} alerts`:'Nominal'),
          h('div',{className:'tb-time'},time),
          h('div',{style:{width:32,height:32,borderRadius:'50%',background:'linear-gradient(135deg,var(--ice3),var(--violet))',display:'grid',placeItems:'center',fontSize:12,fontWeight:800,color:'#fff',cursor:'pointer',border:'2px solid var(--border2)',fontFamily:'var(--fd)'},onClick:()=>nav('settings')},username[0]?.toUpperCase())
        )
      ),

      /* Content */
      h('div',{className:'content'},
        page==='overview'&&h(OverviewPage,{nodes,alerts,onSelectNode:selectNode,toast}),
        page==='nodes'&&h(NodesPage,{nodes,onSelectNode:selectNode,toast,token:token.current}),
        page==='node-detail'&&selNode&&h(NodeDetailPage,{node:selNode,onBack:()=>nav('nodes'),toast}),
        page==='fleet'&&h(FleetPage,{nodes,toast}),
        page==='alerts'&&h(AlertsPage,{alerts,toast}),
        page==='compliance'&&h(CompliancePage,{toast}),
        page==='settings'&&h(SettingsPage,{toast})
      )
    ),

    /* Palette */
    palette&&h(CommandPalette,{nodes,onNav:p=>{nav(p);},onSelectNode:n=>{selectNode(n);},onClose:()=>setPalette(false)}),

    /* Toasts */
    h('div',{className:'toasts'},ts.map(t=>h('div',{key:t.id,className:`toast ${t.type}`},
      h('span',null,t.type==='tok'?'✓':t.type==='terr'?'✗':t.type==='twarn'?'⚠':'ℹ'),
      h('span',null,t.msg)
    )))
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(h(App));
</script>
