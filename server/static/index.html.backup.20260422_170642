<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>JENIX Enterprise — Fleet Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@300;400;500;600&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
:root{
  --void:#02040a;
  --deep:#060c18;
  --surface:#0a1628;
  --card:#0d1d35;
  --card2:#111f38;
  --raised:#15263f;
  --border:rgba(99,179,255,.07);
  --border2:rgba(99,179,255,.13);
  --border3:rgba(99,179,255,.22);
  --text:#e8f4ff;
  --text2:#7ba3cc;
  --text3:#3d618a;
  --text4:#1e3356;
  --ice:#63b3ff;
  --ice2:#93c5fd;
  --ice3:#3b82f6;
  --glow:rgba(99,179,255,.15);
  --glow2:rgba(99,179,255,.06);
  --emerald:#10b981;
  --emerald2:#34d399;
  --ruby:#ef4444;
  --ruby2:#f87171;
  --amber:#f59e0b;
  --amber2:#fcd34d;
  --violet:#8b5cf6;
  --violet2:#a78bfa;
  --cyan:#06b6d4;
  --os-l:#f59e0b;
  --os-m:#a78bfa;
  --os-w:#63b3ff;
  --r:8px;--r2:12px;--r3:16px;--r4:24px;
  --ff:'Manrope',sans-serif;
  --fd:'Syne',sans-serif;
  --fm:'JetBrains Mono',monospace;
  --ease:cubic-bezier(.4,0,.2,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
}
html,body,#root{height:100%;overflow:hidden;background:var(--void);color:var(--text);font-family:var(--ff);font-size:13px}

/* ── Scrollbar ── */
::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--border3)}

/* ── Keyframes ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideRight{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
@keyframes scaleIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.75)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes scanline{0%{top:-10%}100%{top:110%}}
@keyframes gridPulse{0%,100%{opacity:.3}50%{opacity:.6}}
@keyframes ripple{0%{transform:scale(0);opacity:.6}100%{transform:scale(4);opacity:0}}
@keyframes countUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes borderFlow{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@keyframes glowPulse{0%,100%{box-shadow:0 0 20px var(--glow)}50%{box-shadow:0 0 40px rgba(99,179,255,.3)}}
@keyframes toastIn{from{opacity:0;transform:translateX(20px) scale(.95)}to{opacity:1;transform:translateX(0) scale(1)}}
@keyframes progressFill{from{width:0}to{width:var(--target-w)}}

/* ── Shell ── */
.shell{display:grid;grid-template-columns:68px 1fr;height:100vh;overflow:hidden;transition:grid-template-columns .3s var(--ease)}
.shell.wide{grid-template-columns:230px 1fr}
.main{display:grid;grid-template-rows:56px 1fr;overflow:hidden}

/* ── Ambient background ── */
.ambient{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.ambient-orb{position:absolute;border-radius:50%;filter:blur(120px);animation:float 8s ease-in-out infinite}
.amb1{width:600px;height:600px;background:radial-gradient(circle,rgba(59,130,246,.08),transparent 70%);top:-200px;left:-100px;animation-delay:0s}
.amb2{width:400px;height:400px;background:radial-gradient(circle,rgba(139,92,246,.06),transparent 70%);bottom:-100px;right:-100px;animation-delay:-4s}
.amb3{width:300px;height:300px;background:radial-gradient(circle,rgba(16,185,129,.05),transparent 70%);top:40%;right:20%;animation-delay:-2s}
.grid-bg{position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);
  background-size:52px 52px;animation:gridPulse 6s ease-in-out infinite}

/* ── Sidebar ── */
.sidebar{background:var(--deep);border-right:1px solid var(--border);display:flex;flex-direction:column;position:relative;z-index:10;overflow:hidden;transition:width .3s var(--ease)}
.sb-logo{display:flex;align-items:center;gap:10px;padding:16px 14px;border-bottom:1px solid var(--border);cursor:pointer;user-select:none}
.logo-hex{width:36px;height:36px;flex-shrink:0;background:linear-gradient(135deg,var(--ice),var(--violet));clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);display:grid;place-items:center;font-family:var(--fd);font-weight:800;font-size:14px;color:#fff;position:relative;transition:transform .3s var(--spring)}
.logo-hex:hover{transform:scale(1.1) rotate(15deg)}
.sb-logo:hover .logo-hex{transform:scale(1.1) rotate(15deg)}
.logo-wordmark{font-family:var(--fd);font-weight:800;font-size:16px;letter-spacing:.06em;color:var(--text);white-space:nowrap;overflow:hidden}
.logo-sub{font-size:8px;font-family:var(--fm);color:var(--text3);letter-spacing:2px;text-transform:uppercase}
.sb-nav{flex:1;padding:10px 8px;overflow-y:auto;overflow-x:hidden}
.nav-section-label{font-size:8px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--text4);padding:12px 8px 4px;font-family:var(--fm);white-space:nowrap;transition:opacity .2s}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:var(--r2);cursor:pointer;color:var(--text3);font-size:12px;font-weight:600;transition:all .18s var(--ease);position:relative;overflow:hidden;white-space:nowrap;user-select:none;margin-bottom:2px}
.nav-item::before{content:'';position:absolute;inset:0;background:var(--glow2);opacity:0;transition:opacity .18s;border-radius:var(--r2)}
.nav-item:hover{color:var(--text2);background:var(--surface)}
.nav-item:hover::before{opacity:1}
.nav-item.active{color:var(--ice);background:linear-gradient(135deg,rgba(99,179,255,.12),rgba(99,179,255,.06));border:1px solid var(--border2)}
.nav-item.active::after{content:'';position:absolute;left:0;top:15%;height:70%;width:2.5px;background:linear-gradient(to bottom,var(--ice),var(--violet));border-radius:0 2px 2px 0}
.nav-icon{font-size:15px;width:18px;text-align:center;flex-shrink:0;transition:transform .2s var(--spring)}
.nav-item:hover .nav-icon{transform:scale(1.15)}
.nav-label{flex:1;transition:opacity .2s}
.nav-badge{font-size:9px;font-family:var(--fm);padding:2px 6px;border-radius:8px;background:rgba(239,68,68,.15);color:var(--ruby2);border:1px solid rgba(239,68,68,.2);flex-shrink:0;animation:pulse 2s infinite}
.nav-badge.zero{background:var(--surface);color:var(--text3);border-color:var(--border);animation:none}
.nav-toggle{display:flex;align-items:center;justify-content:center;padding:10px;cursor:pointer;color:var(--text3);border-top:1px solid var(--border);margin-top:auto;transition:all .15s;font-size:16px}
.nav-toggle:hover{color:var(--ice);background:var(--surface)}
.sb-user{display:flex;align-items:center;gap:8px;padding:12px;border-top:1px solid var(--border);overflow:hidden}
.user-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--ice3),var(--violet));display:grid;place-items:center;font-size:12px;font-weight:800;color:#fff;flex-shrink:0;font-family:var(--fd);border:2px solid var(--border2)}
.user-info{overflow:hidden;flex:1}
.user-name{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-role{font-size:9px;color:var(--text3);font-family:var(--fm);letter-spacing:.5px;text-transform:uppercase}
.user-logout{color:var(--text3);cursor:pointer;font-size:14px;transition:color .15s;padding:2px}
.user-logout:hover{color:var(--ruby2)}

/* ── Topbar ── */
.topbar{background:var(--deep);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:14px;position:relative;z-index:9}
.topbar::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--ice3),transparent);opacity:.3}
.search-trigger{flex:1;max-width:420px;display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);cursor:pointer;transition:all .2s var(--ease)}
.search-trigger:hover{border-color:var(--border2);background:var(--card);box-shadow:0 0 0 3px var(--glow2)}
.search-icon{color:var(--text3);font-size:13px}
.search-ph{font-size:12px;color:var(--text3);flex:1;font-family:var(--ff)}
.search-kbd{font-size:9px;font-family:var(--fm);color:var(--text4);background:var(--card2);border:1px solid var(--border);border-radius:4px;padding:2px 5px}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.tb-stat{display:flex;flex-direction:column;align-items:center;padding:0 12px;border-left:1px solid var(--border)}
.tb-val{font-family:var(--fm);font-size:15px;font-weight:600;color:var(--text);line-height:1}
.tb-lbl{font-size:8px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-top:2px;font-family:var(--fm)}
.tb-pill{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:20px;font-size:10px;font-family:var(--fm);font-weight:600;border:1px solid;letter-spacing:.3px}
.tb-ok{background:rgba(16,185,129,.1);color:var(--emerald2);border-color:rgba(16,185,129,.2)}
.tb-warn{background:rgba(245,158,11,.1);color:var(--amber2);border-color:rgba(245,158,11,.2)}
.tb-err{background:rgba(239,68,68,.1);color:var(--ruby2);border-color:rgba(239,68,68,.2)}
.live-dot{width:7px;height:7px;border-radius:50%;background:currentColor;animation:pulse 2s infinite}
.tb-time{font-family:var(--fm);font-size:12px;color:var(--text2);padding:0 10px;border-left:1px solid var(--border)}

/* ── Content ── */
.content{overflow-y:auto;overflow-x:hidden;background:var(--void);position:relative;z-index:1}
.page{padding:22px;animation:fadeUp .35s var(--ease)}
.ph{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px}
.ptitle{font-family:var(--fd);font-size:24px;font-weight:800;color:var(--text);letter-spacing:-.5px}
.psub{font-size:11px;color:var(--text3);margin-top:3px;font-family:var(--fm)}

/* ── Cards ── */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r3);padding:18px;position:relative;overflow:hidden;transition:border-color .2s var(--ease),box-shadow .2s var(--ease)}
.card:hover{border-color:var(--border2)}
.card-glow{position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle,var(--glow2),transparent 70%);pointer-events:none}
.card-title{font-size:9px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--text3);font-family:var(--fm);margin-bottom:14px;display:flex;align-items:center;justify-content:space-between}

/* ── Metric cards ── */
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.mc{background:var(--card);border:1px solid var(--border);border-radius:var(--r3);padding:18px 20px;position:relative;overflow:hidden;cursor:default;transition:all .25s var(--ease)}
.mc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent-c,var(--ice)),transparent);opacity:.6}
.mc:hover{transform:translateY(-3px);border-color:var(--border3);box-shadow:0 12px 40px rgba(0,0,0,.4),0 0 0 1px var(--border2)}
.mc-accent-bar{position:absolute;top:0;left:0;right:0;height:2px}
.mc-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;font-size:18px;margin-bottom:14px;flex-shrink:0}
.mc-val{font-family:var(--fd);font-size:32px;font-weight:800;line-height:1;letter-spacing:-1.5px;margin-bottom:5px;animation:countUp .5s var(--ease)}
.mc-lbl{font-size:10px;color:var(--text3);font-weight:600;letter-spacing:.5px;margin-bottom:8px}
.mc-delta{display:inline-flex;align-items:center;gap:4px;font-family:var(--fm);font-size:9px;font-weight:600;padding:2px 7px;border-radius:10px}
.mc-up{color:var(--emerald2);background:rgba(16,185,129,.1)}
.mc-dn{color:var(--ruby2);background:rgba(239,68,68,.1)}
.mc-nt{color:var(--text3);background:var(--surface)}
.mc-bar{height:2px;background:var(--border);border-radius:2px;margin-top:14px;overflow:hidden}
.mc-fill{height:100%;border-radius:2px;transition:width .8s var(--ease)}
.mc-bg{position:absolute;bottom:-10px;right:6px;font-size:56px;opacity:.04;pointer-events:none;line-height:1}

/* ── Node cards ── */
.node-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(295px,1fr));gap:11px}
.nc{background:var(--card);border:1px solid var(--border);border-radius:var(--r3);padding:16px;cursor:pointer;transition:all .22s var(--ease);position:relative;overflow:hidden}
.nc::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--glow2),transparent);opacity:0;transition:opacity .2s;border-radius:var(--r3)}
.nc:hover{border-color:var(--border3);box-shadow:0 10px 40px rgba(0,0,0,.5);transform:translateY(-2px)}
.nc:hover::after{opacity:1}
.nc.active{border-color:rgba(99,179,255,.3);background:rgba(99,179,255,.04)}
.nc-stripe{position:absolute;top:0;left:0;bottom:0;width:3px;border-radius:var(--r3) 0 0 var(--r3)}
.nc-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:13px;position:relative;z-index:1}
.nc-name{font-family:var(--fd);font-size:14px;font-weight:800;color:var(--text);letter-spacing:-.3px}
.nc-host{font-family:var(--fm);font-size:9px;color:var(--text3);margin-top:2px}
.nc-badges{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.os-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:20px;font-size:9px;font-weight:700;font-family:var(--fm);letter-spacing:.5px}
.osl{background:rgba(245,158,11,.12);color:var(--os-l);border:1px solid rgba(245,158,11,.25)}
.osm{background:rgba(167,139,250,.12);color:var(--os-m);border:1px solid rgba(167,139,250,.25)}
.osw{background:rgba(99,179,255,.12);color:var(--os-w);border:1px solid rgba(99,179,255,.25)}
.status-dot-wrap{display:flex;align-items:center;gap:5px;font-size:9px;font-family:var(--fm)}
.sdot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.sdot-on{background:var(--emerald);box-shadow:0 0 8px var(--emerald);animation:pulse 2s infinite}
.sdot-off{background:var(--ruby)}
.nc-health{position:relative;z-index:1;margin-bottom:12px}
.nc-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;position:relative;z-index:1}
.nc-m{background:var(--surface);border-radius:var(--r);padding:7px 8px;border:1px solid var(--border)}
.nc-mv{font-family:var(--fm);font-size:13px;font-weight:600;line-height:1;margin-bottom:3px}
.nc-mk{font-size:8px;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase}
.nc-mbar{height:2px;background:var(--border);border-radius:2px;margin-top:5px;overflow:hidden}
.nc-mfill{height:100%;border-radius:2px;transition:width .6s var(--ease)}
.nc-foot{display:flex;justify-content:space-between;font-size:9px;color:var(--text3);font-family:var(--fm);margin-top:10px;position:relative;z-index:1}

/* ── Health ring ── */
.hring{display:inline-flex;position:relative}
.hring svg{transform:rotate(-90deg)}
.hring-val{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--fm);font-size:10px;font-weight:600}

/* ── Charts ── */
.chart-wrap{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:14px}
.chart3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:14px}
.chart2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}

/* ── Tabs ── */
.tabs{display:flex;gap:3px;border-bottom:1px solid var(--border);margin-bottom:18px}
.tab{padding:9px 16px;font-size:11px;font-weight:600;color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s;font-family:var(--fm);letter-spacing:.5px;text-transform:uppercase;white-space:nowrap}
.tab:hover{color:var(--text2)}
.tab.on{color:var(--ice);border-bottom-color:var(--ice)}

/* ── Detail layout ── */
.det2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.det-full{grid-column:1/-1}

/* ── Terminal ── */
.terminal{background:#010812;border:1px solid var(--border2);border-radius:var(--r2);overflow:hidden;font-family:var(--fm);font-size:11px}
.term-bar{display:flex;align-items:center;gap:6px;padding:8px 12px;background:var(--deep);border-bottom:1px solid var(--border)}
.tdot{width:10px;height:10px;border-radius:50%}
.term-body{padding:12px;max-height:260px;overflow-y:auto}
.tl{line-height:1.75}
.tl-cmd{color:var(--ice2)}
.tl-out{color:rgba(120,200,160,.9)}
.tl-ok{color:var(--emerald2)}
.tl-err{color:var(--ruby2)}
.tl-sys{color:var(--violet2)}
.term-input-row{display:flex;align-items:center;gap:8px;padding:8px 12px;border-top:1px solid var(--border);background:var(--deep)}
.term-ps{color:var(--emerald2);flex-shrink:0}
.term-in{flex:1;background:transparent;border:none;outline:none;color:var(--ice2);font-family:var(--fm);font-size:11px}
.term-quick{display:flex;flex-wrap:wrap;gap:5px;padding:8px 12px;border-top:1px solid var(--border)}
.qcmd{font-size:9px;font-family:var(--fm);padding:3px 8px;border-radius:4px;background:var(--surface);border:1px solid var(--border2);color:var(--text3);cursor:pointer;transition:all .12s;white-space:nowrap}
.qcmd:hover{background:var(--card2);color:var(--ice);border-color:var(--border3)}

/* ── Process table ── */
.ptable{width:100%;border-collapse:collapse;font-size:11px}
.ptable th{padding:6px 10px;text-align:left;font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--text3);border-bottom:1px solid var(--border);font-family:var(--fm);font-weight:600}
.ptable td{padding:7px 10px;border-bottom:1px solid rgba(255,255,255,.03);color:var(--text2);font-family:var(--fm)}
.ptable tr:hover td{background:var(--surface);color:var(--text)}
.ptable tr:last-child td{border-bottom:none}
.pname{color:var(--text);font-weight:600}

/* ── Ports ── */
.ports-grid{display:flex;flex-wrap:wrap;gap:5px}
.port-chip{padding:4px 9px;border-radius:5px;font-family:var(--fm);font-size:10px;font-weight:500;cursor:default;transition:all .15s;border:1px solid}
.port-known{background:rgba(16,185,129,.08);color:var(--emerald2);border-color:rgba(16,185,129,.2)}
.port-chip:hover{transform:scale(1.05)}

/* ── CVE ── */
.cve-item{display:flex;gap:10px;padding:10px 12px;border-radius:var(--r);border:1px solid var(--border);margin-bottom:5px;transition:background .15s;align-items:flex-start}
.cve-item:hover{background:var(--surface)}
.cve-sev{font-size:8px;font-weight:700;letter-spacing:1px;padding:2px 7px;border-radius:3px;font-family:var(--fm);flex-shrink:0;margin-top:1px;text-transform:uppercase}
.crit{background:rgba(239,68,68,.15);color:var(--ruby2);border:1px solid rgba(239,68,68,.3)}
.high{background:rgba(245,158,11,.15);color:var(--amber2);border:1px solid rgba(245,158,11,.3)}
.med{background:rgba(6,182,212,.15);color:var(--cyan);border:1px solid rgba(6,182,212,.3)}
.low{background:rgba(16,185,129,.15);color:var(--emerald2);border:1px solid rgba(16,185,129,.3)}

/* ── Alerts ── */
.alert-item{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:var(--r2);border:1px solid var(--border);margin-bottom:5px;transition:all .15s;cursor:default}
.alert-item:hover{background:var(--surface);border-color:var(--border2)}
.alert-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* ── Compliance ── */
.fw-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r3);padding:18px;transition:all .2s var(--ease)}
.fw-card:hover{border-color:var(--border2);transform:translateY(-1px)}
