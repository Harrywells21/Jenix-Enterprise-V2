[Unit]
Description=JENIX Enterprise Floor 2 (sales copy, port 8001)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aadi/Desktop/sales/jenix/server
EnvironmentFile=/home/aadi/Desktop/sales/jenix/server/.env
ExecStart=/home/aadi/Desktop/sales/jenix/server_venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
User=aadi
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
