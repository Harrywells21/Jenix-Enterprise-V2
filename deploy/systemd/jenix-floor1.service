[Unit]
Description=JENIX Enterprise Floor 1 (working repo, port 8000)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aadi/Desktop/jenix/server
EnvironmentFile=/home/aadi/Desktop/jenix/server/.env
ExecStart=/home/aadi/Desktop/jenix/server_venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
User=aadi
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
